# 阿里云百炼 API Key (在 https://bailian.console.aliyun.com 获取)
DASHSCOPE_API_KEY=your-api-key-here

# 服务配置
HOST=0.0.0.0
PORT=8001

# 文件存储
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# 最大上传文件大小 (字节，默认 10MB = 10485760)
MAX_UPLOAD_SIZE=10485760

# AI 模型配置 (qwen-image 需要 Workspace ID)
# 注意: qwen-image-3.0-pro 支持图生图，qwen-image-3.0 基础版可能不支持
DEFAULT_MODEL=qwen-image-3.0-pro
WORKSPACE_ID=your-workspace-id-here
